# Токен бота от @BotFather (отдельный бот, не тот, что у радара)
BOT_TOKEN=
# Куда присылать заявки (chat id менеджера). Команда /leads работает только в этом чате
ADMIN_CHAT_ID=
# ИИ-ответы: любая нейросеть с OpenAI-совместимым API. Без ключа бот отвечает по готовым FAQ.
# Примеры AI_BASE_URL / AI_MODEL:
#   DeepSeek:  https://api.deepseek.com/v1          deepseek-chat
#   YandexGPT: https://llm.api.cloud.yandex.net/v1  gpt://<folder_id>/yandexgpt-lite/latest
#   OpenAI:    https://api.openai.com/v1            gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
